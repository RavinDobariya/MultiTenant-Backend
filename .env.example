APP_NAME=Doc Management API
ENV=dev

JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=multitenant_docs
DATABASE_URL=mysql+mysqlconnector://root:@127.0.0.1:3306/multitenant_docs

REDIS_URL=redis://127.0.0.1:6379/0
DEFAULT_TTL=300
REDIS_BROKER_URL=redis://127.0.0.1:6379/1
REDIS_BACKEND_URL=redis://127.0.0.1:6379/2

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fastapi_docs

LOG_LEVEL=INFO
